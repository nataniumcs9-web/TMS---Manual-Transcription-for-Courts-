<Window x:Class="TranscriberClient.Views.UserSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Settings" Icon="/Assets/gzhc.ico" Width="620" Height="650" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="User settings" FontSize="21" FontWeight="Bold"/>
            <TextBlock x:Name="UserNameText" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="System">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Dashboard and display preferences" FontWeight="Bold" FontSize="15" Margin="0,0,0,14"/>
                    <TextBlock Grid.Row="1" Text="Automatic refresh" VerticalAlignment="Center" Margin="0,8"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="RefreshIntervalComboBox" Height="34" VerticalContentAlignment="Center" Margin="0,4">
                        <ComboBoxItem Content="15 seconds" Tag="15"/>
                        <ComboBoxItem Content="30 seconds" Tag="30"/>
                        <ComboBoxItem Content="60 seconds" Tag="60"/>
                        <ComboBoxItem Content="120 seconds" Tag="120"/>
                        <ComboBoxItem Content="5 minutes" Tag="300"/>
                    </ComboBox>
                    <TextBlock Grid.Row="2" Text="Dashboard layout" VerticalAlignment="Center" Margin="0,8"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,4">
                        <CheckBox x:Name="AlwaysOnTopCheckBox" Content="Keep dashboard on top" Margin="0,5"/>
                        <CheckBox x:Name="CompactDashboardCheckBox" Content="Use compact rows to show more assignments" Margin="0,5"/>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="Calendar display" VerticalAlignment="Center" Margin="0,8"/>
                    <CheckBox Grid.Row="3" Grid.Column="1" x:Name="EthiopianCalendarCheckBox" Content="Show dates in the Ethiopian calendar (E.C.)" VerticalAlignment="Center" Margin="0,5"/>
                    <Border Grid.Row="4" Grid.ColumnSpan="2" Background="#F3F6FA" CornerRadius="6" Padding="12" VerticalAlignment="Top" Margin="0,12,0,0">
                        <TextBlock Text="Date display changes only how dates appear and are entered. Dates stored in the court database remain Gregorian."
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Change password">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Change your transcriber password" FontWeight="Bold" FontSize="15" Margin="0,0,0,14"/>
                    <TextBlock Grid.Row="1" Text="Current password" VerticalAlignment="Center" Margin="0,8"/>
                    <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="CurrentPasswordBox" Height="36" Margin="0,4"/>
                    <TextBlock Grid.Row="2" Text="New password" VerticalAlignment="Center" Margin="0,8"/>
                    <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="NewPasswordBox" Height="36" Margin="0,4"/>
                    <TextBlock Grid.Row="3" Text="Confirm new password" VerticalAlignment="Center" Margin="0,8"/>
                    <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="ConfirmPasswordBox" Height="36" Margin="0,4"/>
                    <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="Use at least 12 characters. Your current password is verified before any account change is saved."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top" Margin="0,12,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save system settings" Width="155" Click="SaveSystemSettingsButton_Click"/>
                <Button Content="Change password" Width="145" Click="ChangePasswordButton_Click"/>
                <Button Content="Close" Width="80" IsCancel="True" Margin="0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
