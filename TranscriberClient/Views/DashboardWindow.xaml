<Window x:Class="TranscriberClient.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Court Transcriber | Dashboard" Icon="/Assets/gzhc.ico" Width="1280" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrandBrush}" CornerRadius="9" Padding="22,18" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="54" Height="54" Background="White" CornerRadius="27" Padding="6" Margin="0,0,14,0">
                            <Image Source="/Assets/logo.png" Stretch="Uniform"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="GEDEO ZONE HIGH COURT" Foreground="#B9D8E4" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="የጌዴኦ ዞን ከፍተኛ ፍርድ ቤት" Foreground="#D8E7EF" FontSize="14" FontFamily="Nyala"/>
                            <TextBlock Text="{Binding CurrentUser.FullName}" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="AlwaysOnTopCheckBox" Content="Always on top" Foreground="White" VerticalAlignment="Center" Margin="0,0,18,0"
                              Checked="AlwaysOnTopChecked" Unchecked="AlwaysOnTopChecked"/>
                    <Button Content="Refresh" Background="{StaticResource AccentBrush}" Click="RefreshButton_Click"/>
                    <Button Content="Sign out" Background="#FFFFFF" Foreground="{StaticResource BrandBrush}" Margin="0" Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14">
            <TabControl Background="White" BorderThickness="0">
                <TabItem Header="Assigned">
                    <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding AssignedRecords}" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="R.N" Binding="{Binding Id}" Width="55"/>
                            <DataGridTextColumn Header="File #" Binding="{Binding FileNum}" Width="75"/>
                            <DataGridTextColumn Header="Machine #" Binding="{Binding MachineNum}" Width="85"/>
                            <DataGridTextColumn Header="Applicant" Binding="{Binding Applicant}" Width="1.2*"/>
                            <DataGridTextColumn Header="Defendant" Binding="{Binding Defendant}" Width="1.2*"/>
                            <DataGridTextColumn Header="Witness type" Binding="{Binding WitnessType}" Width="110"/>
                            <DataGridTextColumn Header="Recorded" Binding="{Binding RecDate, StringFormat=d}" Width="95"/>
                            <DataGridTextColumn Header="Appointed" Binding="{Binding AppointedOn, StringFormat=d}" Width="95"/>
                            <DataGridTextColumn Header="Audio" Binding="{Binding AudioStatus}" Width="85"/>
                            <DataGridTextColumn Header="Remark" Binding="{Binding Remark}" Width="1.2*"/>
                            <DataGridTemplateColumn Header="" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><Button Content="Start work" Margin="5,0" Height="29" Click="StartWorkButton_Click"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Pending">
                    <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding PendingRecords}" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="R.N" Binding="{Binding Id}" Width="55"/>
                            <DataGridTextColumn Header="File #" Binding="{Binding FileNum}" Width="75"/>
                            <DataGridTextColumn Header="Machine #" Binding="{Binding MachineNum}" Width="85"/>
                            <DataGridTextColumn Header="Applicant" Binding="{Binding Applicant}" Width="1.2*"/>
                            <DataGridTextColumn Header="Defendant" Binding="{Binding Defendant}" Width="1.2*"/>
                            <DataGridTextColumn Header="Witness type" Binding="{Binding WitnessType}" Width="110"/>
                            <DataGridTextColumn Header="Recorded" Binding="{Binding RecDate, StringFormat=d}" Width="95"/>
                            <DataGridTextColumn Header="Appointed" Binding="{Binding AppointedOn, StringFormat=d}" Width="95"/>
                            <DataGridTextColumn Header="Audio" Binding="{Binding AudioStatus}" Width="85"/>
                            <DataGridTextColumn Header="Remark" Binding="{Binding Remark}" Width="1.2*"/>
                            <DataGridTemplateColumn Header="" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><Button Content="Continue" Margin="5,0" Height="29" Click="StartWorkButton_Click"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Suspended">
                    <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding SuspendedRecords}" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="R.N" Binding="{Binding Id}" Width="55"/>
                            <DataGridTextColumn Header="File #" Binding="{Binding FileNum}" Width="75"/>
                            <DataGridTextColumn Header="Machine #" Binding="{Binding MachineNum}" Width="85"/>
                            <DataGridTextColumn Header="Applicant" Binding="{Binding Applicant}" Width="1.2*"/>
                            <DataGridTextColumn Header="Defendant" Binding="{Binding Defendant}" Width="1.2*"/>
                            <DataGridTextColumn Header="Witness type" Binding="{Binding WitnessType}" Width="110"/>
                            <DataGridTextColumn Header="Recorded" Binding="{Binding RecDate, StringFormat=d}" Width="95"/>
                            <DataGridTextColumn Header="Appointed" Binding="{Binding AppointedOn, StringFormat=d}" Width="95"/>
                            <DataGridTextColumn Header="Audio" Binding="{Binding AudioStatus}" Width="85"/>
                            <DataGridTextColumn Header="Remark" Binding="{Binding Remark}" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Finished">
                    <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding FinishedRecords}" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="R.N" Binding="{Binding Id}" Width="55"/>
                            <DataGridTextColumn Header="File #" Binding="{Binding FileNum}" Width="75"/>
                            <DataGridTextColumn Header="Machine #" Binding="{Binding MachineNum}" Width="85"/>
                            <DataGridTextColumn Header="Applicant" Binding="{Binding Applicant}" Width="1.2*"/>
                            <DataGridTextColumn Header="Defendant" Binding="{Binding Defendant}" Width="1.2*"/>
                            <DataGridTextColumn Header="Witness type" Binding="{Binding WitnessType}" Width="110"/>
                            <DataGridTextColumn Header="Recorded" Binding="{Binding RecDate, StringFormat=d}" Width="95"/>
                            <DataGridTextColumn Header="Appointed" Binding="{Binding AppointedOn, StringFormat=d}" Width="95"/>
                            <DataGridTextColumn Header="Audio" Binding="{Binding AudioStatus}" Width="85"/>
                            <DataGridTextColumn Header="Remark" Binding="{Binding Remark}" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
