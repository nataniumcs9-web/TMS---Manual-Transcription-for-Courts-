<Window x:Class="TranscriberClient.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gedeo Zone High Court" Icon="/Assets/gzhc.ico" Width="780" Height="525" MinWidth="780" MinHeight="525"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#102A46" AllowsTransparency="True">
    <Border CornerRadius="20" BorderBrush="#315574" BorderThickness="1" Padding="45">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Width="168" Height="168" Background="White" CornerRadius="84" Padding="18"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="/Assets/logo.png" Stretch="Uniform"/>
            </Border>
            <TextBlock Grid.Row="1" Text="GEDEO ZONE HIGH COURT" Foreground="White" FontSize="29" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
            <TextBlock Grid.Row="2" Text="የጌዴኦ ዞን ከፍተኛ ፍርድ ቤት" Foreground="#D8E7EF" FontSize="29" FontFamily="Nyala"
                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                <ProgressBar Width="145" Height="5" IsIndeterminate="True" Foreground="#37B6AA" Background="#315574"/>
                <TextBlock Text="  Preparing transcriber workspace" Foreground="#B9D8E4" FontSize="15" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
