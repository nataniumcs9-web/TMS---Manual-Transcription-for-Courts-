<Window x:Class="TranscriberClient.Views.DatabaseSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Database Settings" Icon="/Assets/gzhc.ico" Width="440" Height="390"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="125"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="MySQL database connection" FontSize="19" FontWeight="Bold" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Text="Server / IP" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="ServerTextBox" Height="28" Margin="0,5"/>

        <TextBlock Grid.Row="2" Text="Port" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="PortTextBox" Height="28" Margin="0,5"/>

        <TextBlock Grid.Row="3" Text="Database name" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="DatabaseTextBox" Height="28" Margin="0,5"/>

        <TextBlock Grid.Row="4" Text="Database username" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="UsernameTextBox" Height="28" Margin="0,5"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Database password" VerticalAlignment="Top" Margin="0,10"/>
        <PasswordBox Grid.Row="5" Grid.Column="1" x:Name="PasswordBox" Height="28" Margin="0,5"/>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2">
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Test Connection" Width="120" Height="34" Margin="0,0,8,0" Click="TestConnectionButton_Click"/>
                <Button Content="Save" Width="80" Height="34" Margin="0,0,8,0" Click="SaveButton_Click"/>
                <Button Content="Cancel" Width="80" Height="34" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
