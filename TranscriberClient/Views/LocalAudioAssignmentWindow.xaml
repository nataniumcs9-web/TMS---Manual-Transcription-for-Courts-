<Window x:Class="TranscriberClient.Views.LocalAudioAssignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Local Audio Assignment" Icon="/Assets/gzhc.ico" Width="680" Height="760" MinWidth="600" MinHeight="650"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Create a local audio assignment" FontSize="21" FontWeight="Bold"/>
            <TextBlock Text="Audio and case details are stored on this computer and remain available when the server is offline."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Audio file *" VerticalAlignment="Center" Margin="0,7"/>
                <Grid Grid.Row="0" Grid.Column="1" Margin="0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="AudioPathTextBox" IsReadOnly="True" Height="36" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="Choose audio…" Width="120" Margin="8,0,0,0" Click="ChooseAudioButton_Click"/>
                </Grid>
                <TextBlock Grid.Row="1" Text="Court file number *" VerticalAlignment="Center" Margin="0,7"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="FileNumberTextBox" Height="34" VerticalContentAlignment="Center" Margin="0,4"/>
                <TextBlock Grid.Row="2" Text="Machine number" VerticalAlignment="Center" Margin="0,7"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="MachineNumberTextBox" Height="34" VerticalContentAlignment="Center" Margin="0,4"/>
                <TextBlock Grid.Row="3" Text="Applicant *" VerticalAlignment="Center" Margin="0,7"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="ApplicantTextBox" Height="34" VerticalContentAlignment="Center" Margin="0,4"/>
                <TextBlock Grid.Row="4" Text="Defendant *" VerticalAlignment="Center" Margin="0,7"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="DefendantTextBox" Height="34" VerticalContentAlignment="Center" Margin="0,4"/>
                <TextBlock Grid.Row="5" Text="Recorded date *" VerticalAlignment="Center" Margin="0,7"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="RecordedDateTextBox" Height="34" VerticalContentAlignment="Center" Margin="0,4" ToolTip="Enter yyyy-MM-dd in Gregorian mode or d MonthName yyyy in Ethiopian mode."/>
                <TextBlock Grid.Row="6" Text="Appointment date" VerticalAlignment="Center" Margin="0,7"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="AppointmentDateTextBox" Height="34" VerticalContentAlignment="Center" Margin="0,4" ToolTip="Enter yyyy-MM-dd in Gregorian mode or d MonthName yyyy in Ethiopian mode."/>
                <TextBlock Grid.Row="7" Text="Witness type" VerticalAlignment="Center" Margin="0,7"/>
                <TextBox Grid.Row="7" Grid.Column="1" x:Name="WitnessTypeTextBox" Height="34" VerticalContentAlignment="Center" Margin="0,4"/>
                <TextBlock Grid.Row="8" Text="Witnesses" VerticalAlignment="Center" Margin="0,7"/>
                <TextBox Grid.Row="8" Grid.Column="1" x:Name="WitnessesTextBox" Height="34" VerticalContentAlignment="Center" Margin="0,4"/>
                <TextBlock Grid.Row="9" Text="Trial / case type" VerticalAlignment="Center" Margin="0,7"/>
                <TextBox Grid.Row="9" Grid.Column="1" x:Name="TrialTextBox" Height="34" VerticalContentAlignment="Center" Margin="0,4"/>
                <TextBlock Grid.Row="10" Text="Judge" VerticalAlignment="Center" Margin="0,7"/>
                <TextBox Grid.Row="10" Grid.Column="1" x:Name="JudgeTextBox" Height="34" VerticalContentAlignment="Center" Margin="0,4"/>
                <TextBlock Grid.Row="11" Text="Notes" VerticalAlignment="Top" Margin="0,12"/>
                <TextBox Grid.Row="11" Grid.Column="1" x:Name="RemarkTextBox" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,4"/>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="ValidationText" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save on this computer" Width="175" Click="SaveButton_Click"/>
                <Button Content="Cancel" Width="85" Margin="0" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
