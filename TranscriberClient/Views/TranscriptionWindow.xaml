<Window x:Class="TranscriberClient.Views.TranscriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Court Transcriber | Audio controls" Icon="/Assets/gzhc.ico" Height="550" Width="740" MinWidth="660" MinHeight="500"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Topmost="False">
    <Grid x:Name="LayoutGrid" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrandBrush}" CornerRadius="7" Padding="14,9" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="35" Height="35" Background="White" CornerRadius="18" Padding="4" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Image Source="/Assets/logo.png" Stretch="Uniform"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TRANSCRIBER" Foreground="#B9D8E4" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding WindowTitle}" Foreground="White" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <CheckBox Grid.Column="2" x:Name="AlwaysOnTopCheckBox" Content="Always on top" Foreground="White"
                          VerticalAlignment="Center" Margin="0,0,12,0"
                          Checked="AlwaysOnTopCheckBox_Changed" Unchecked="AlwaysOnTopCheckBox_Changed"/>
                <Border Grid.Column="3" Background="#284D70" CornerRadius="4" Padding="9,5" VerticalAlignment="Center">
                    <TextBlock x:Name="PedalStatusText" Text="Pedal: Not found" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                </Border>
                <Button Grid.Column="4" x:Name="CompactModeButton" Content="− Minimize" Background="#FFFFFF" Foreground="{StaticResource BrandBrush}"
                        Margin="10,0,0,0" Padding="10,0" Click="CompactModeButton_Click"/>
            </Grid>
        </Border>

        <Border x:Name="CaseDetailsPanel" Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,7"><TextBlock Text="FILE / MACHINE" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock><Run x:Name="FileNumberRun"/><Run Text=" / "/><Run x:Name="MachineNumberRun"/></TextBlock></StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,7"><TextBlock Text="APPLICANT" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="ApplicantText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,8,7"><TextBlock Text="DEFENDANT" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="DefendantText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,7"><TextBlock Text="RECORDED / APPOINTED" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock><Run x:Name="RecordedDateRun"/><Run Text=" / "/><Run x:Name="AppointedDateRun"/></TextBlock></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="WITNESS TYPE" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="WitnessTypeText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="TRIAL / JUDGE" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="TrialJudgeText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"><TextBlock Text="RECORDER / WITNESSES" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="RecorderWitnessesText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Grid>
        </Border>

        <Border x:Name="AudioPanel" Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Text="AUDIO PLAYBACK" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TimeText" Text="00:00 / 00:00" FontWeight="SemiBold" FontSize="13"/>
                <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="SeekSlider" Minimum="0" Maximum="100" ValueChanged="SeekSlider_ValueChanged" Margin="0,4,0,0"/>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,7,0,0">
                    <Button Content="−3 sec" Width="68" Click="RewindButton_Click"/>
                    <Button x:Name="PlayPauseButton" Content="Play / Pause" Width="100" Background="{StaticResource AccentBrush}" Click="PlayPauseButton_Click"/>
                    <Button Content="+3 sec" Width="68" Click="ForwardButton_Click"/>
                    <TextBlock Text="Volume" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,5,0"/>
                    <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="1" Value="0.8" ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="DocumentPanel" Grid.Row="3" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock Text="DOCUMENT" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="OpenDocumentButton" Content="Open / create" Background="{StaticResource AccentBrush}" Click="OpenDocumentButton_Click"/>
                    <Button x:Name="OpenDocumentsFolderButton" Content="Show in Explorer" Background="#E9EFF5" Foreground="{StaticResource BrandBrush}" Click="OpenDocumentsFolderButton_Click"/>
                    <Button x:Name="InsertTimestampButton" Content="Insert timestamp" Background="#E9EFF5" Foreground="{StaticResource BrandBrush}" Click="InsertTimestampButton_Click"/>
                    <Button x:Name="BringWordToFrontButton" Content="Bring Word forward" Background="#E9EFF5" Foreground="{StaticResource BrandBrush}" Margin="0" Click="BringWordToFrontButton_Click"/>
                </DockPanel>
                <TextBlock x:Name="DocumentPathText" Text="Opens an existing .docx or .doc; creates .docx if neither exists."
                           Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <Border x:Name="WorkPanel" Grid.Row="4" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="STATUS" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <ComboBox Grid.Column="1" x:Name="StatusComboBox" Height="30" SelectedIndex="0" SelectionChanged="StatusComboBox_SelectionChanged">
                    <ComboBoxItem Content="Pending"/><ComboBoxItem Content="Suspended"/>
                </ComboBox>
                <TextBlock Grid.Column="2" Text="REMARK" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Top" Margin="14,8,8,0"/>
                <TextBox Grid.Column="3" x:Name="RemarkText" MinHeight="40" MaxHeight="75" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>

        <Border x:Name="FooterPanel" Grid.Row="5" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,8,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Foot pedal controls active when connected" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Save" Background="{StaticResource AccentBrush}" Click="SaveProgressButton_Click"/>
                    <Button Content="Finish" Background="#28744A" Click="FinishButton_Click"/>
                    <Button Content="Exit" Background="#E9EFF5" Foreground="{StaticResource BrandBrush}" Margin="0" Click="ExitButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
