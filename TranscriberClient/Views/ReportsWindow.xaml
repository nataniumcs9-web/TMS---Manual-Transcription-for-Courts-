<Window x:Class="TranscriberClient.Views.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transcription Reports" Icon="/Assets/gzhc.ico" Width="1180" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Work reports" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Review your workload and export a filtered report for your records." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="145"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="145"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="155"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="From" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker Grid.Column="1" x:Name="StartDatePicker" Height="34" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="To" VerticalAlignment="Center" Margin="14,0,8,0"/>
                <DatePicker Grid.Column="3" x:Name="EndDatePicker" Height="34" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="Status" VerticalAlignment="Center" Margin="14,0,8,0"/>
                <ComboBox Grid.Column="5" x:Name="StatusComboBox" Height="34" VerticalContentAlignment="Center" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="All statuses" Tag="All"/>
                    <ComboBoxItem Content="Assigned" Tag="Assigned"/>
                    <ComboBoxItem Content="In progress" Tag="Pending"/>
                    <ComboBoxItem Content="Suspended" Tag="Suspended"/>
                    <ComboBoxItem Content="Finished" Tag="Finished"/>
                </ComboBox>
                <Button Grid.Column="7" Content="Apply filters" Width="110" Margin="10,0,0,0" Click="ApplyFiltersButton_Click"/>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,10">
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="TOTAL RECORDS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TotalCountText" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrandBrush}"/><TextBlock Text="In selected report" FontSize="10" Foreground="{StaticResource MutedBrush}"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="ACTIVE WORK" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ActiveCountText" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Not yet finished" FontSize="10" Foreground="{StaticResource MutedBrush}"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="APPOINTMENTS PASSED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="OverdueCountText" FontSize="24" FontWeight="Bold" Foreground="#B54738"/><TextBlock Text="Active records to review" FontSize="10" Foreground="{StaticResource MutedBrush}"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12">
                <StackPanel><TextBlock Text="COMPLETION RATE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="CompletionRateText" FontSize="24" FontWeight="Bold" Foreground="#32805B"/><TextBlock Text="Finished / total" FontSize="10" Foreground="{StaticResource MutedBrush}"/></StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="WORKLOAD BY STATUS" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding StatusChart}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="10" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1" Height="12" Maximum="100" Value="{Binding Percent}" Foreground="{Binding Color}" Background="#EDF1F5" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="APPOINTMENT HEALTH" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding AppointmentChart}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="10" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1" Height="12" Maximum="100" Value="{Binding Percent}" Foreground="{Binding Color}" Background="#EDF1F5" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10">
            <DataGrid x:Name="ReportGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="True" RowHeight="34">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95"/>
                    <DataGridTextColumn Header="File #" Binding="{Binding FileNum}" Width="75"/>
                    <DataGridTextColumn Header="Machine #" Binding="{Binding MachineNum}" Width="90"/>
                    <DataGridTextColumn Header="Applicant" Binding="{Binding Applicant}" Width="1.2*"/>
                    <DataGridTextColumn Header="Defendant" Binding="{Binding Defendant}" Width="1.2*"/>
                    <DataGridTextColumn Header="Judge" Binding="{Binding Judge}" Width="*"/>
                    <DataGridTextColumn Header="Recorded" Binding="{Binding RecDate, StringFormat=d}" Width="95"/>
                    <DataGridTextColumn Header="Appointment" Binding="{Binding AppointedOn, StringFormat=d}" Width="100"/>
                    <DataGridTextColumn Header="Finished" Binding="{Binding FinishedDate, StringFormat=d}" Width="95"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Export Excel" Width="115" Background="{StaticResource AccentBrush}" Click="ExportExcelButton_Click"/>
                <Button Content="Export PDF" Width="105" Click="ExportPdfButton_Click"/>
                <Button Content="Close" Width="80" Margin="0" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
