<Window x:Class="TranscriberClient.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Court Transcriber | Sign in" Icon="/Assets/gzhc.ico" Width="520" Height="650" MinHeight="620" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrandBrush}" CornerRadius="10,10,0,0" Padding="20,14">
            <DockPanel>
                <Border Width="72" Height="72" Background="White" CornerRadius="36" Padding="7" DockPanel.Dock="Left" Margin="0,0,16,0">
                    <Image Source="/Assets/logo.png" Stretch="Uniform"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GEDEO ZONE HIGH COURT" Foreground="White" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="የጌዴኦ ዞን ከፍተኛ ፍርድ ቤት" Foreground="#D8E7EF" FontSize="16" FontFamily="Nyala" Margin="0,3,0,0"/>
                    <TextBlock Text="Transcriber workspace" Foreground="#B9D8E4" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="0,0,10,10" Padding="28,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Sign in to continue" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="Username" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="UsernameTextBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="42" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <TextBlock Text="Password" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                    <PasswordBox x:Name="PasswordBox" Height="42" Margin="0,6,0,0"/>
                </StackPanel>
                <TextBlock Grid.Row="3" x:Name="ErrorText" Foreground="#B42318" Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Grid.Row="4">
                    <Button x:Name="LoginButton" Content="Sign in" Height="44" Margin="0" Click="LoginButton_Click"/>
                    <Button Content="Database connection settings" Height="40" Margin="0,10,0,0"
                            Background="#E9EFF5" Foreground="{StaticResource BrandBrush}" Click="DatabaseSettingsButton_Click"/>
                    <TextBlock Text="Court Transcriber Desktop" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
