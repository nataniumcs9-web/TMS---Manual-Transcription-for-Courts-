<Window x:Class="TranscriberClient.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Court Transcriber | Sign in" Icon="/Assets/gzhc.ico" Width="520" Height="650" MinHeight="620" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrandBrush}" CornerRadius="10,10,0,0" Padding="20,14">
            <Border.Resources>
                <Storyboard x:Key="RotateMarks">
                    <DoubleAnimation Storyboard.TargetName="OuterMarkRotation" Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:24" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="InnerMarkRotation" Storyboard.TargetProperty="Angle"
                                     From="360" To="0" Duration="0:0:17" RepeatBehavior="Forever"/>
                </Storyboard>
            </Border.Resources>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource RotateMarks}"/>
                </EventTrigger>
            </Border.Triggers>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="72" Height="72" Background="White" CornerRadius="36" Padding="7" Margin="0,0,16,0">
                    <Image Source="/Assets/logo.png" Stretch="Uniform"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="GEDEO ZONE HIGH COURT" Foreground="White" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="የጌዴኦ ዞን ከፍተኛ ፍርድ ቤት" Foreground="#D8E7EF" FontSize="16" FontFamily="Nyala" Margin="0,3,0,0"/>
                    <TextBlock Text="Transcriber workspace" Foreground="#B9D8E4" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <Canvas Grid.Column="2" Width="70" Height="70" VerticalAlignment="Center" Opacity="0.55">
                    <Ellipse Width="48" Height="48" Stroke="#9FD3DD" StrokeThickness="1.5"
                             Canvas.Left="7" Canvas.Top="8" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><RotateTransform x:Name="OuterMarkRotation"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="27" Height="27" Stroke="#FFFFFF" StrokeThickness="1.5"
                             Canvas.Left="18" Canvas.Top="18" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><RotateTransform x:Name="InnerMarkRotation"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="6" Height="6" Fill="#9FD3DD" Canvas.Left="28" Canvas.Top="29"/>
                </Canvas>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="0,0,10,10" Padding="28,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Sign in to continue" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="Username" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="UsernameTextBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="42" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <TextBlock Text="Password" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                    <PasswordBox x:Name="PasswordBox" Height="42" Margin="0,6,0,0"/>
                </StackPanel>
                <TextBlock Grid.Row="3" x:Name="ErrorText" Foreground="#B42318" Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Grid.Row="4">
                    <Button x:Name="LoginButton" Content="Sign in" Height="44" Margin="0" Click="LoginButton_Click"/>
                    <Button Content="Database connection settings" Height="40" Margin="0,10,0,0"
                            Background="#E9EFF5" Foreground="{StaticResource BrandBrush}" Click="DatabaseSettingsButton_Click"/>
                    <TextBlock Text="Court Transcriber Desktop" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock Text="Developer: Natnael Abebe · nataniumcs9@gmail.com"
                               HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
